{
  "info": {
    "name": "RES Exam Bank API",
    "_postman_id": "c2fe0eb4-5a95-4727-8e23-f3677ca15467",
    "description": "API collection for RES Exam Bank — auth, topics, practice, attempt submission, and progress.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "jwtToken",
      "value": ""
    },
    {
      "key": "topicId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo User\",\n  \"email\": \"demo@resexambank.sg\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@resexambank.sg\",\n  \"password\": \"Password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Topics",
      "item": [
        {
          "name": "Get All Topics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/topics"
          }
        },
        {
          "name": "Get Paper 1 Topics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/topics?paper=PAPER_1"
          }
        },
        {
          "name": "Get Paper 2 Topics",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/topics?paper=PAPER_2"
          }
        }
      ]
    },
    {
      "name": "Practice",
      "item": [
        {
          "name": "Get Topic Questions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/practice/topics/{{topicId}}/questions"
          }
        },
        {
          "name": "Random Practice - Paper 1",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/practice/random?paper=PAPER_1"
          }
        },
        {
          "name": "Mock Exam - Paper 2",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/practice/mock?paper=PAPER_2"
          }
        }
      ]
    },
    {
      "name": "Attempts",
      "item": [
        {
          "name": "Submit Attempt",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paper\": \"PAPER_1\",\n  \"mode\": \"TOPIC\",\n  \"topicId\": 1,\n  \"answers\": [\n    { \"questionId\": 1, \"selectedOptionId\": 2 },\n    { \"questionId\": 2, \"selectedOptionId\": 5 }\n  ]\n}"
            },
            "url": "{{baseUrl}}/attempts"
          }
        }
      ]
    },
    {
      "name": "Progress",
      "item": [
        {
          "name": "Get Progress Summary",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{jwtToken}}" }],
            "url": "{{baseUrl}}/progress/summary"
          }
        }
      ]
    }
  ]
}
